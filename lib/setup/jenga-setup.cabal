cabal-version: 3.4
name:          jenga-setup
version:       0.1
license:       BSD-3-Clause

library
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  hs-source-dirs:   src
  exposed-modules:
    Jenga.Setup.Utils
  ghc-options: -Wall
  build-depends:
    base >= 4.7 && < 5,
    Cabal >= 3.0 && < 4,
    directory >= 1.3.6 && < 2,
    filepath >= 1.4 && < 2

  if !(arch(javascript) || arch(wasm32))
    exposed-modules:
      Jenga.Setup.Backend
      Jenga.Setup.Frontend.Js
      Jenga.Setup.Frontend.Wasm
      Jenga.Setup.Static
    build-depends:
      containers,
      jenga-asset-manifest,
      process >= 1.6 && < 2,
      text
