cabal-version:      3.0
name:               jenga-route-servant
version:            0.1.0.0
synopsis:           Servant-based routing for Jenga (frontend-safe, no native deps)
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
    Jenga.Route
    Jenga.Route.Frontend
    Jenga.Route.TH
    Jenga.Frontend

  build-depends:
    , base              >=4.12 && <5
    , bytestring
    , containers
    , data-default
    , dependent-sum
    , effectful-core
    , ghcjs-dom
    , jsaddle
    , lens
    , reflex
    , reflex-dom-core
    , reflex-effectful
    , text

  hs-source-dirs:   src
  default-language: GHC2024

  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
