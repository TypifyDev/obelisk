-- Isolated cabal.project for building Reflex.Effectful.DomHost against
-- eff-reflex (the reflex fork at ../eff-reflex, package name `reflex`).
-- Builds the DOM host and its direct Reflex dependencies independently
-- of the application packages.
--
-- Scope of this project:
--   * reflex-dom-core-effectful — this package (variant A)
--   * reflex                    — from ../eff-reflex/
--
-- All other lib packages in thunks/jenga/lib/ are intentionally excluded.
packages:
  .
  ../eff-reflex
  ../reflex-dom-core

-- variant B's own test suite requires chrome-test-utils which isn't in
-- this project; only its library is needed.
package reflex-dom-core
  tests: False
  benchmarks: False

-- Also disable flags that pull in the missing test-only chrome deps.
constraints:
  reflex-dom-core -gc-tests,
  -- Keep the WebDriver API used by hspec-webdriver and these suites.
  -- The 0.12.0.1 release exports WD, Config and Session; 0.15 removed
  -- those APIs. The browser components declare this same constraint so
  -- the parent application project also selects the intended version.
  hspec-webdriver == 1.2.2,
  webdriver       == 0.12.0.1,
  -- Same shell.nix / ghcWithPackages set — pin these so cabal doesn't
  -- re-resolve to newer versions from Hackage, which would then be
  -- ambiguous with the pre-built copies in the GHC package DB.
  async           == 2.2.5,
  lens            == 5.3.5,
  network         == 3.2.8.0,
  hspec           == 2.11.14,
  hspec-core      == 2.11.14

-- Enable the selected test components explicitly with --enable-tests.
