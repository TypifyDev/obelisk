cabal-version:      3.0
name:               reflex-dom-core-effectful
version:            0.1.0.0
synopsis:           Effectful-native port of reflex-dom-core
license:            BSD-3-Clause
build-type:         Simple

extra-source-files:
  src-ghc/Reflex/Effectful/Dom/Foreign/JavaScript/Internal/Utils.hs
  src-ghcjs/Reflex/Effectful/Dom/Foreign/JavaScript/Internal/Utils.hs

flag use-template-haskell
  description: Use template haskell to generate lenses
  default: True
  manual: True

flag use-reflex-optimizer
  description: Use the GHC plugin Reflex.Optimizer on some of the modules in the package.  This is still experimental.
  default: False
  manual: True

flag expose-all-unfoldings
  description: Build the library with -fexpose-all-unfoldings which can help client code specialize better
  default: False
  manual: True

flag profile-reflex
  description: Add a layer of profiling to all Reflex events in the system
  default: False
  manual: True


-- Effectful DOM host with MTL class instances and widget re-exports.
library
  exposed-modules:
    Reflex.Effectful.DomHost


  -- MTL modules re-exported from Hackage 'reflex-dom-core' so downstream
  -- consumers using @DomBuilder t m@-style constraints (i.e. code ported
  -- from ancient reflex-dom v4 @MonadWidget t m@) get the MTL class in
  -- scope without declaring @reflex-dom-core@ as a direct build-dep.
  -- The class instance for @Eff es@ ships in 'Reflex.Effectful.DomHost',
  -- so MTL widget code compiles fine on the Effectful stack.
  reexported-modules:
      reflex-dom-core:Reflex.Dom.Builder.Class
    , reflex-dom-core:Reflex.Dom.Class
    , reflex-dom-core:Reflex.Dom.Widget.Basic
    , reflex-dom-core:Reflex.Dom.Core

  other-modules:
    Reflex.Effectful.Dom.Foreign.JavaScript.Internal.Utils

  build-depends:
    , aeson
    , base                    >=4.12 && <5
    , bimap
    , blaze-builder
    , bytestring
    , case-insensitive
    , commutative-semigroups
    , containers
    , data-default
    , dependent-map
    , dependent-sum
    , dependent-sum-template
    , effectful-core          >=2.3
    , exception-transformers
    , ghcjs-dom
    , jsaddle
    , jsaddle-warp
    , keycode
    , lens
    , monad-control
    , mtl
    , network-uri
    , patch
    , primitive
    , ref-tf
    , reflex
    , reflex-dom-core
    , semialign
    , stm
    , template-haskell
    , text
    , these
    , transformers
    , jsaddle-dom-extras

  hs-source-dirs:   src

  if impl(ghcjs) || arch(javascript)
    hs-source-dirs: src-ghcjs
    build-depends:
      ghcjs-base,
      hashable >= 1.2 && < 1.6
  else
    hs-source-dirs: src-ghc
    if !os(windows)
      build-depends: unix >= 2.7 && <2.9

  default-language: GHC2024
  ghc-options:      -Wall
  cpp-options:      -DUSE_TEMPLATE_HASKELL

  if flag(expose-all-unfoldings)
    ghc-options: -fexpose-all-unfoldings

  if flag(use-reflex-optimizer)
    ghc-options: -fplugin=Reflex.Optimizer

  if flag(profile-reflex)
    cpp-options: -DPROFILE_REFLEX

  default-extensions:
    DataKinds
    FlexibleContexts
    GADTs
    LambdaCase
    OverloadedStrings
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

-- NOTE: Most of the test-suites below carry `buildable: False` because
-- they depend on the removed `reflex` package (variant A's
-- shim). Their sources are kept as reference material for the ongoing
-- port into `Reflex.Effectful.DomHost` — as each area lands there, the
-- corresponding test-suite can be re-pointed at
-- `reflex-dom-core-effectful` and un-disabled.
--
-- The `dom-host-smoke` and `package-boots-smoke` test-suites depend
-- ONLY on `reflex-dom-core-effectful` itself and are buildable.

test-suite dom-host-smoke
  type:               exitcode-stdio-1.0
  main-is:            DomHostSmoke.hs
  hs-source-dirs:     test
  build-depends:
    , base
    , reflex-dom-core
    , reflex-dom-core-effectful
    , transformers
  default-language:   GHC2024
  ghc-options:        -Wall

-- Smoke test for AdjustableE-based composers (Phases 2-4).
-- Link-time verification that mainWidgetAE + WidgetRowE + GuestEff
-- compose cleanly. Widget body is trivial (no DOM yet; that's Phase 5).
