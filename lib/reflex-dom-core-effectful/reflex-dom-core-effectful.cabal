cabal-version:      3.0
name:               reflex-dom-core-effectful
version:            0.1.0.0
synopsis:           Effectful-native port of reflex-dom-core
license:            BSD-3-Clause
build-type:         Simple

extra-source-files:
  src-ghc/Reflex/Effectful/Dom/Foreign/JavaScript/Internal/Utils.hs
  src-ghcjs/Reflex/Effectful/Dom/Foreign/JavaScript/Internal/Utils.hs

flag use-template-haskell
  description: Use template haskell to generate lenses
  default: True
  manual: True

flag use-reflex-optimizer
  description: Use the GHC plugin Reflex.Optimizer on some of the modules in the package.  This is still experimental.
  default: False
  manual: True

flag expose-all-unfoldings
  description: Build the library with -fexpose-all-unfoldings which can help client code specialize better
  default: False
  manual: True

flag profile-reflex
  description: Add a layer of profiling to all Reflex events in the system
  default: False
  manual: True


test-suite host-frame-isolation
  type: exitcode-stdio-1.0
  main-is: HostFrameIsolation.hs
  hs-source-dirs: test
  build-depends: base, async, reflex-dom-core-effectful
  default-language: GHC2024
  ghc-options: -Wall -threaded -O2

-- Effectful DOM host with MTL class instances and widget re-exports.
library
  exposed-modules:
    Reflex.Effectful.DomHost
    Reflex.Effectful.DomHostInterpose


  -- MTL modules re-exported from Hackage 'reflex-dom-core' so downstream
  -- consumers using @DomBuilder t m@-style constraints (i.e. code ported
  -- from ancient reflex-dom v4 @MonadWidget t m@) get the MTL class in
  -- scope without declaring @reflex-dom-core@ as a direct build-dep.
  -- The class instance for @Eff es@ ships in 'Reflex.Effectful.DomHost',
  -- so MTL widget code compiles fine on the Effectful stack.
  reexported-modules:
      reflex-dom-core:Reflex.Dom.Builder.Class
    , reflex-dom-core:Reflex.Dom.Class
    , reflex-dom-core:Reflex.Dom.Widget.Basic
    , reflex-dom-core:Reflex.Dom.Core

  other-modules:
    Reflex.Effectful.Dom.Foreign.JavaScript.Internal.Utils

  build-depends:
    , aeson
    , base                    >=4.12 && <5
    , bimap
    , blaze-builder
    , bytestring
    , case-insensitive
    , commutative-semigroups
    , containers
    , data-default
    , dependent-map
    , dependent-sum
    , dependent-sum-template
    , effectful-core          >=2.3
    , exception-transformers
    , ghcjs-dom
    , jsaddle
    , keycode
    , lens
    , monad-control
    , mtl
    , network-uri
    , patch
    , primitive
    , ref-tf
    , reflex
    , reflex-dom-core
    , semialign
    , stm
    , template-haskell
    , text
    , these
    , transformers
    , jsaddle-dom-extras

  hs-source-dirs:   src

  if arch(wasm32)
    build-depends: jsaddle-wasm >= 0.1 && < 0.2
  else
    build-depends: jsaddle-warp

  if impl(ghcjs) || arch(javascript)
    hs-source-dirs: src-ghcjs
    build-depends:
      ghcjs-base,
      hashable >= 1.2 && < 1.6
  else
    hs-source-dirs: src-ghc
    if !os(windows)
      build-depends: unix >= 2.7 && <2.9

  default-language: GHC2024
  ghc-options:      -Wall
  cpp-options:      -DUSE_TEMPLATE_HASKELL

  if flag(expose-all-unfoldings)
    ghc-options: -fexpose-all-unfoldings

  if flag(use-reflex-optimizer)
    ghc-options: -fplugin=Reflex.Optimizer

  if flag(profile-reflex)
    cpp-options: -DPROFILE_REFLEX

  default-extensions:
    DataKinds
    FlexibleContexts
    GADTs
    LambdaCase
    OverloadedStrings
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

-- The dom-host suites exercise the active interpreter. The two legacy
-- static-render and widget-input suites retain their existing disabled
-- status; their sources are shared with the corresponding dom-host suites.

test-suite dom-host-smoke
  type:               exitcode-stdio-1.0
  main-is:            DomHostSmoke.hs
  hs-source-dirs:     test
  build-depends:
    , base
    , reflex-dom-core
    , reflex-dom-core-effectful
    , transformers
  default-language:   GHC2024
  ghc-options:        -Wall

-- Smoke test for AdjustableE-based composers (Phases 2-4).
-- Link-time verification that mainWidgetAE + WidgetRowE + GuestEff
-- compose cleanly. Widget body is trivial (no DOM yet; that's Phase 5).
test-suite dom-host-smoke-ae
  type:               exitcode-stdio-1.0
  main-is:            DomHostSmokeAE.hs
  hs-source-dirs:     test
  build-depends:
    , base
    , effectful-core
    , reflex
    , reflex-dom-core-effectful
  default-language:   GHC2024
  ghc-options:        -Wall

-- AE-composer variant of dom-host-hydration-browser. All 103 test
-- cases, all composer/harness function names substituted for their
-- *AE variants. Build errors surface which AE-composer functions
-- still need to be written (Phase 5-9).
test-suite dom-host-hydration-browser-ae
  if os(linux)
    build-depends: linux-namespaces
  type:               exitcode-stdio-1.0
  main-is:            HydrationBrowserAE.hs
  other-modules:      Test.Util.ChromeFlags
                      Test.Util.UnshareNetwork
  hs-source-dirs:     test
  build-depends:
    , async
    , base
    , bytestring
    , constraints-extras
    , containers
    , dependent-map
    , dependent-sum
    , dependent-sum-template
    , directory
    , exceptions
    , filepath
    , ghcjs-dom
    , hspec
    , hspec-core
    , hspec-webdriver
    , http-types
    , HUnit
    , jsaddle
    , jsaddle-warp
    , lens
    , mtl
    , network
    , unix
    , process
    , random
    , ref-tf
    , reflex
    , reflex-dom-core
    , reflex-dom-core-effectful
    , silently
    , some
    , temporary
    , text
    , wai
    , warp
    , webdriver == 0.12.0.1
    , websockets
    , which
  default-language:   GHC2024
  default-extensions:
    RankNTypes
    ScopedTypeVariables
    TemplateHaskell
    TypeApplications
  ghc-options:        -threaded -Wall -Wno-orphans -Wno-unused-imports

