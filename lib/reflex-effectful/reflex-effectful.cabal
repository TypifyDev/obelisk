cabal-version:      3.0
name:               reflex-effectful
version:            0.1.0.0
synopsis:           Effectful-based interface for reflex (headless, no DOM)
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
    Reflex.Effectful.Types
    Reflex.Effectful.Effect.Sample
    Reflex.Effectful.Effect.Hold
    Reflex.Effectful.Effect.PostBuild
    Reflex.Effectful.Effect.TriggerEvent
    Reflex.Effectful.Effect.PerformEvent
    Reflex.Effectful.Effect.EventWriter
    Reflex.Effectful.Effect.NotReady
    Reflex.Effectful.Effect.DynamicWriter
    Reflex.Effectful.Effect.BehaviorWriter
    Reflex.Effectful.Effect.Requester
    Reflex.Effectful.Effect.Query
    -- MVP: native FRP engine (own types + primitives; no reflex dep)
    Reflex.Effectful.Core.Types
    Reflex.Effectful.Core.Timeline
    Reflex.Effectful.Core.Monads.EventME
    Reflex.Effectful.Core.Monads.BehaviorME
    Reflex.Effectful.Core.Monads.PushME
    Reflex.Effectful.Core.Monads.PullME
    Reflex.Effectful.Core.Monads.ReadPhaseE
    Reflex.Effectful.Core.Primitives
    Reflex.Effectful.Core.Primitives.Pull
    Reflex.Effectful.Core.Primitives.Fan
    Reflex.Effectful.Core.Primitives.Incremental
    Reflex.Effectful.Core.Primitives.Merge
    Reflex.Effectful.Core.Primitives.Switch
    Reflex.Effectful.Core.Primitives.Coincidence
    Reflex.Effectful.Core.Primitives.Adjust
    Reflex.Effectful.Core.Experimental.CachedBehavior
    Reflex.Effectful.Core.Experimental.FrameHeight
    Reflex.Effectful.Core.Experimental.WeakSubs
    Reflex.Effectful.Core.Scheduler
    Reflex.Effectful.Core.DynamicInstances
    Reflex.Effectful.Core.Class
    Reflex.Effectful.Core.Profiled
    Reflex.Effectful.Core.Pure
    Reflex.Effectful.Core.Class.TriggerEvent
    Reflex.Effectful.Core.Class.PostBuild
    Reflex.Effectful.Core.Class.Adjustable
    Reflex.Effectful.Core.Class.PerformEvent
    Reflex.Effectful.Core.Time
    Reflex.Effectful.Core.Primitives.FanInt
    Reflex.Effectful.Core.Requester
    Reflex.Effectful.Core.Trace
    -- Ports from upstream reflex (namespaced to avoid module collision)
    Reflex.Effectful.Data.Functor.Misc
    Reflex.Effectful.Data.Map.Misc
    Reflex.Effectful.Data.AppendMap
    Reflex.Effectful.Data.FastMutableIntMap
    Reflex.Effectful.Data.WeakBag
    Reflex.Effectful.Data.FastWeakBag
    Reflex.Effectful.Control.Monad.ReaderIO
    Reflex.Effectful.FunctorMaybe
    Reflex.Effectful.FastWeak
    Reflex.Effectful.Dynamic.Uniq
    Reflex.Effectful.Dynamic.TH
    Reflex.Effectful.Host.Headless
    Reflex.Effectful.Network
    Reflex.Effectful.Collection
    Reflex.Effectful.Workflow
    Reflex.Effectful.Internal.Main
    -- Ports of the 11 reflex class modules (Phase 1 of dropping the
    -- `reflex` build-dep). Verbatim copies from upstream with only the
    -- module header + intra-set imports renamed. Consumer code / our
    -- own instances still target the upstream `reflex` classes; those
    -- get swapped over to these ports in Phases 2-4.
    Reflex.Effectful.Class
    Reflex.Effectful.Class.Adjustable.Class
    Reflex.Effectful.Class.PostBuild.Class
    Reflex.Effectful.Class.PerformEvent.Class
    Reflex.Effectful.Class.TriggerEvent.Class
    Reflex.Effectful.Class.NotReady.Class
    Reflex.Effectful.Class.Requester.Class
    Reflex.Effectful.Class.Query.Class
    Reflex.Effectful.Class.EventWriter.Class
    Reflex.Effectful.Class.DynamicWriter.Class
    Reflex.Effectful.Class.BehaviorWriter.Class

  build-depends:
    , base            >=4.12 && <5
    , commutative-semigroups
    , constraints
    , containers
    , data-default
    , dependent-map
    , dependent-sum
    , effectful-core   >=2.3
    , exceptions
    , haskell-src-exts
    , haskell-src-meta
    , MemoTrie
    , monoidal-containers
    , mtl
    , patch
    , primitive
    , ref-tf
    , reflection
    , reflex
    , semialign
    , semigroupoids
    , transformers
    , some
    , syb
    , template-haskell
    , text
    , these
    , time
    , witherable

  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:       -Wall

  default-extensions:
    DataKinds
    FlexibleContexts
    FunctionalDependencies
    GADTs
    LambdaCase
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
    UndecidableInstances

test-suite core-engine-smoke
  type:               exitcode-stdio-1.0
  main-is:            CoreEngineSmoke.hs
  hs-source-dirs:     test
  build-depends:
