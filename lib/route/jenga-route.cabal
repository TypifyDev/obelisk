cabal-version: 2.2
name: jenga-route
version: 0.2
build-type: Simple

common warnings
  ghc-options: -Wall -Werror -fprint-potential-instances -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: warnings
  hs-source-dirs: src
  build-depends: base,
                 aeson,
                 bytestring,
                 categories,
                 constraints,
                 constraints-extras,
                 containers,
                 dependent-map,
                 dependent-sum,
                 dependent-sum-template,
                 either,
                 ghcjs-dom,
                 http-types,
                 jsaddle,
                 lens,
                 mmorph,
                 monad-control,
                 mtl,
                 network-uri,
                 jenga-executable-config-lookup,
                 primitive,
                 ref-tf,
                 reflex,
                 reflex-dom-core,
                 semigroupoids,
                 template-haskell,
                 tabulation,
                 text,
                 transformers,
                 universe,
                 universe-some

  exposed-modules: Jenga.Route
                   Jenga.Route.TH
                   Jenga.Route.Frontend

  ghc-options: -O

test-suite roundtrips
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  ghc-options: -O

  -- https://gitlab.haskell.org/ghc/ghc/-/issues/25442
  if !os(wasi)
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N"

  -- https://gitlab.haskell.org/ghc/ghc/-/merge_requests/14362
  if arch(javascript)
    ld-options: -sEXPORTED_RUNTIME_METHODS=HEAP8

  build-depends:
    QuickCheck,
    aeson,
    base,
    categories,
    containers,
    dependent-map,
    dependent-sum,
    dependent-sum-template,
    lens,
    some,
    jenga-route,
    quickcheck-instances,
    tabulation,
    tasty,
    tasty-quickcheck,
    text,
    transformers,
    universe,
    universe-some
