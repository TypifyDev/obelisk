cabal-version: 2.0
name: jenga-snap-extras
version: 0.1
synopsis: Extra functionality for Snap that should be considered for upstreaming
license: BSD-3-Clause
build-type: Simple

library
  hs-source-dirs: src

  build-depends:
      aeson
    , attoparsec
    , base
    , bytestring
    , snap-core
    , directory
    , filepath
    , text
    , unordered-containers

  exposed-modules:
      Jenga.Snap.Extras

  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -O

  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies

  if arch(javascript) || arch(wasm32)
    buildable: False
