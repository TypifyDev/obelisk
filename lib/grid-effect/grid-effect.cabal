cabal-version:      2.4
name:               grid-effect
version:            0.1.0.0
synopsis:           Type-level grid budget tracking as an effect system
description:
  Compile-time layout budget enforcement via an indexed monad over effectful.
  .
  Each @consume@ call subtracts from a type-level rational budget. Overflow
  is a compile-time type error. Row breaks reset the budget. The system
  supports both integer column counts and fractional layouts.
  .
  Integrates with reflex-classh for type-safe Tailwind CSS grid generation.

license:            BSD-3-Clause
author:             Galen Sprout
maintainer:         galen.sprout@gmail.com
category:           Control, UI
build-type:         Simple

library
  exposed-modules:
    Grid.Effect.Rational
    Grid.Effect.Indexed
    Grid.Effect.Budget
    Grid.Effect.Eff
  build-depends:
      base                      >= 4.14 && < 5
    , effectful-core             >= 2.3
  if !(arch(javascript) || arch(wasm32))
    build-depends:
        ghc-typelits-natnormalise >= 0.7
      , ghc-typelits-knownnat     >= 0.7
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall

  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
    AllowAmbiguousTypes
    NoStarIsType

test-suite grid-effect-test
  type:             exitcode-stdio-1.0
  main-is:          Test.hs
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
    NoStarIsType
  build-depends:
      base                      >= 4.14 && < 5
    , grid-effect
    , effectful-core             >= 2.3
    , ghc-typelits-natnormalise >= 0.7
    , ghc-typelits-knownnat     >= 0.7
