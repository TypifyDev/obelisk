cabal-version:      3.0
name:               reflex-dom-effectful
version:            0.1.0.0
synopsis:           Effectful-based interface for reflex-dom
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
    Reflex.Effectful
    Reflex.Effectful.Types
    Reflex.Effectful.Effect.Sample
    Reflex.Effectful.Effect.Hold
    Reflex.Effectful.Effect.PostBuild
    Reflex.Effectful.Effect.TriggerEvent
    Reflex.Effectful.Effect.PerformEvent
    Reflex.Effectful.Effect.Adjustable
    Reflex.Effectful.Effect.Dom
    Reflex.Effectful.Effect.Prerender
    Reflex.Effectful.Effect.JSM
    Reflex.Effectful.Effect.HasDocument
    Reflex.Effectful.Effect.DomRenderHook
    Reflex.Effectful.Effect.EventWriter
    Reflex.Effectful.Effect.NotReady
    Reflex.Effectful.Effect.DynamicWriter
    Reflex.Effectful.Effect.BehaviorWriter
    Reflex.Effectful.Effect.Requester
    Reflex.Effectful.Effect.Query
    Reflex.Effectful.Widget.Input
    Reflex.Effectful.Widget.Basic
    Reflex.Effectful.XHR.FormData
    Reflex.Effectful.Run
    Reflex.Effectful.Time
    Reflex.Effectful.Internal.Channel
    Reflex.Effectful.Internal.HonestMain
    Reflex.Effectful.Internal.HonestMainDom
    -- Jenga-specific effect wrappers moved to jenga-frontend:
    --   Reflex.Effectful.Jenga                    -> Jenga.Frontend.Effectful
    --   Reflex.Effectful.Effect.Jenga.Configs     -> Jenga.Frontend.Effectful.Configs
    --   Reflex.Effectful.Effect.Jenga.Cookies     -> Jenga.Frontend.Effectful.Cookies
    --   Reflex.Effectful.Effect.Jenga.Route       -> Jenga.Frontend.Effectful.Route
    -- reflex-dom-effectful is library-agnostic; those wrappers belong with jenga.

  other-modules:
    Reflex.Effectful.Internal.Interpret
    Reflex.Effectful.Internal.WidgetLoop
    Reflex.Effectful.Internal.Main

  build-depends:
    , base            >=4.12 && <5
    , bimap
    , bytestring
    , commutative-semigroups
    , containers
    , data-default
    , dependent-map
    , dependent-sum
    , effectful-core   >=2.3
    , ghcjs-dom
    , jsaddle
    , jsaddle-warp
    , lens
    , patch
    , reflex
    , reflex-dom-core
    , semialign
    , text
    , these
    , time

  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:       -Wall

  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies

-- Aspirational full DOM/jsaddle smoke suite. Targets the SHIM API
-- (Reflex.Effectful) as it exists today; will be re-pointed at the
-- honest API in Phase C. Kept in the tree so the shape is visible,
-- but not built as part of the Phase-A acceptance suite.
--
-- test-suite reflex-dom-effectful-honest-port-smoke
--   type:             exitcode-stdio-1.0
--   main-is:          HonestPortSmoke.hs
--   hs-source-dirs:   test
--   default-language: GHC2024
--   ghc-options:      -Wall -threaded
--   build-depends:
--     , base            >=4.12 && <5
--     , containers
--     , effectful-core   >=2.3
--     , jsaddle
--     , jsaddle-warp
--     , patch
--     , reflex
--     , reflex-dom-core
--     , reflex-dom-effectful
--     , text

-- Phase-A acceptance suite: headless, no jsaddle, no DOM.
-- Proves the ambient Spider handle shape ('HostEnv') works end-to-end
-- for sample / hold / getPostBuild. If this passes, Phase-B agents can
-- build per-class interpreters on top of Reflex.Effectful.Internal.HonestMain
-- per /tmp/phase-b-briefing.md.
test-suite reflex-dom-effectful-honest-spider-smoke
  type:             exitcode-stdio-1.0
  main-is:          HonestSpiderSmoke.hs
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall -threaded
  build-depends:
    , base            >=4.12 && <5
    , effectful-core   >=2.3
    , reflex
    , reflex-dom-effectful

-- Verifies that documented 'error "..."' stubs in the library actually
-- fire with their documented messages when reached. Prevents a future
-- refactor from silently downgrading a panic into a fallback.
-- Header of the .hs enumerates all 4 stubs and marks the 3 that are
-- deferred pending a full Spider-host test harness.
test-suite stub-errors-smoke
  type:             exitcode-stdio-1.0
  main-is:          StubErrorsSmoke.hs
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall -threaded
  build-depends:
    , base            >=4.12 && <5
    , containers
    , reflex-dom-effectful

