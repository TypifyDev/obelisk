name: jenga-executable-config-lookup
version: 0.1.1
cabal-version: 2.0
build-type: Simple

library
  exposed-modules: Jenga.ExecutableConfig.Lookup, Jenga.Configs

  if impl(ghcjs) || arch(javascript) || arch(wasm32)
    hs-source-dirs: src-js, src
    build-depends: ghcjs-dom
  else
    hs-source-dirs: src-other, src
    other-modules: Jenga.Configs.Internal.Directory
    build-depends: directory

  build-depends:
    base,
    base64-bytestring,
    bytestring,
    containers,
    exceptions,
    exception-transformers,
    filepath,
    jsaddle,
    mmorph,
    monad-control,
    mtl,
    primitive,
    ref-tf,
    reflex-dom-core,
    reflex,
    text,
    transformers-base,
    transformers

  ghc-options: -Wall
