name: jenga-executable-config-lookup
version: 0.1.1
cabal-version: 2.0
build-type: Simple

library
  exposed-modules: Jenga.ExecutableConfig.Lookup, Jenga.Configs, Jenga.Configs.MTL

  if impl(ghcjs) || arch(javascript) || arch(wasm32)
    hs-source-dirs: src-js, src
    build-depends: ghcjs-dom
  else
    hs-source-dirs: src-other, src
    other-modules: Jenga.Configs.Internal.Directory
    build-depends: directory

  build-depends:
    base,
    base64-bytestring,
    bytestring,
    containers,
    effectful-core,
    exceptions,
    filepath,
    jsaddle,
    mmorph,
    monad-control,
    mtl,
    primitive,
    ref-tf,
    reflex,
    reflex-dom-core,
    reflex-dom-core-effectful,
    text,
    transformers,
    transformers-base

  ghc-options: -Wall

  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
