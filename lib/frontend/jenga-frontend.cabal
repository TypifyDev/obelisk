cabal-version: 3.4
name: jenga-frontend
version: 0.1
build-type: Simple

library
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  hs-source-dirs: src
  build-depends: base,
                 base64-bytestring,
                 bytestring,
                 containers,
                 cookie,
                 effectful-core,
                 ghcjs-dom,
                 jenga-route,
                 jsaddle,
                 network-uri,
                 reflex,
                 reflex-dom-core-effectful,
                 text
  exposed-modules:
    Jenga.Frontend
    Jenga.Frontend.Cookie
    Jenga.Frontend.Effectful
    Jenga.Frontend.Effectful.Configs
    Jenga.Frontend.Effectful.Cookies
    Jenga.Frontend.Effectful.Route
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -O
