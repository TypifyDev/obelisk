cabal-version: 3.4
name: jenga-frontend
version: 0.1
build-type: Simple

library
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  hs-source-dirs: src
  build-depends: base,
                 base64-bytestring,
                 bytestring,
                 containers,
                 cookie,
                 effectful-core,
                 ghcjs-dom,
                 jenga-route,
                 jenga-executable-config-lookup,
                 reflex-dom-core,
                 primitive,
                 ref-tf,
                 jsaddle,
                 network-uri,
                 reflex,
                 reflex-dom-core-effectful,
                 text
  exposed-modules:
    Jenga.Frontend
    Jenga.Frontend.MTL
    Jenga.Frontend.Cookie
    Jenga.Frontend.Effectful
    Jenga.Frontend.Effectful.Configs
    Jenga.Frontend.Effectful.Cookies
    Jenga.Frontend.Effectful.Route
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -O

test-suite frontend-rendering
  type: exitcode-stdio-1.0
  main-is: FrontendRendering.hs
  hs-source-dirs: test
  default-language: GHC2024
  ghc-options: -Wall -Werror -threaded
  build-depends: base, bytestring, containers, text,
                 jenga-frontend, jenga-route, jenga-executable-config-lookup,
                 reflex-dom-core, reflex-dom-core-effectful
