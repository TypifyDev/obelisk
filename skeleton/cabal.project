packages:
  common
  frontend

optional-packages:
  static/generated

if !(arch(javascript) || arch(wasm32))
  packages:
    backend
    landing-page

  optional-packages:
    frontend/js
    frontend/wasm
    static/generated/custom

-- Uncomment to develop jenga libraries and reflex-dom locally.
-- Not needed for normal development; nix provides these via source-repository-packages.
--optional-packages:
--  thunks/jenga/lib/*
--  thunks/jenga/lib/*/*
--
--optional-packages:
--  thunks/jenga/thunks/reflex-dom/*

multi-repl: True
-- Re-enabled to investigate the LinkInMemory panic prior turns noted.



if !(arch(javascript) || arch(wasm32))
  package reflex-dom
    flags: +use-warp -webkit2gtk

if arch(wasm32)
  shared: True
